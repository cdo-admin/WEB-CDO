{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["meta"] }]
  },
  "overrides": [
    { "files": ["src/main.jsx"], "rules": { "react/only-export-components": "off" } },
    { "files": ["src/test/**", "src/**/*.test.{js,jsx}"], "rules": { "react/only-export-components": "off" } }
  ]
}
